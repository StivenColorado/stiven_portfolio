{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node --env-file=.env --disable-warning=ExperimentalWarning server/index.ts",
    "server:hash": "node server/scripts/hash-password.ts",
    "test:server": "node --test 'server/**/*.test.ts'",
    "typecheck": "tsc -b",
    "assets": "sh scripts/optimize-assets.sh",
    "email:build": "tsx --tsconfig emails/tsconfig.json scripts/build-emails.tsx",
    "email:dev": "email dev --dir emails --port 3099"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.19.2",
    "i18next": "^26.4.2",
    "lucide-react": "^0.525.0",
    "mmdb-lib": "^3.0.3",
    "mobx": "^6.13.7",
    "mobx-react": "^9.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.15",
    "react-router": "^7.6.3",
    "tailwindcss": "^4.1.11",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@types/node": "^24.0.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "react-email": "^6.11.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0"
  }
}
