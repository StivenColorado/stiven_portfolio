# Web3Forms — formulario de contacto (https://web3forms.com)
# Crea una access key GRATIS poniendo tu correo de destino y pégala aquí.
VITE_WEB3FORMS_KEY=tu-access-key-aqui

# Servidor de visitas y admin (server/)
PORT=3001
HOST=127.0.0.1
DB_PATH=server/data/visits.sqlite
GEO_DB=server/data/dbip-city-lite.mmdb
# Genera el hash con: echo -n "tu-password" | pnpm server:hash
ADMIN_PASSWORD_HASH=
TRUST_PROXY=0
RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
# Imágenes y videos subidos desde el admin (en producción: /var/lib/stiven-portfolio/media)
MEDIA_DIR=server/data/media
# Carpeta del frontend con /projects/** para la migración de imágenes viejas (en producción: /var/www/stiven-portfolio)
PUBLIC_DIR=
# Token fine-grained de solo lectura (Contents y Metadata) para la actividad de GitHub; vacío la desactiva
GITHUB_TOKEN=
SESSION_HOURS=12
COOKIE_SECURE=1
# Auth del admin por correo (se siembra una vez en la DB si está vacía; luego manda la DB)
ADMIN_EMAIL=stivenchoo@gmail.com
PUBLIC_URL=http://localhost:5173
MAIL_FROM="Stiven Colorado <no-reply@negocioempresarial.online>"
MAIL_REPLY_TO=stivenchoo@gmail.com
BREVO_API_KEY=
